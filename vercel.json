{
  "functions": {
    "api/script.js": {
      "includeFiles": "api/**"
    }
  },
  "headers": [
    {
      "source": "/api/script",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
